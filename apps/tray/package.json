{
  "name": "jobtrack",
  "version": "1.0.3",
  "type": "module",
  "license": "MIT",
  "description": "Runs the JobTrack API + web UI as one background process with a Windows tray icon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CuplexUser/JobTrack.git",
    "directory": "apps/tray"
  },
  "homepage": "https://github.com/CuplexUser/JobTrack#readme",
  "main": "./src/cli.ts",
  "bin": {
    "jobtrack": "./bin/jobtrack.js"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/cli.ts",
    "start": "tsx src/cli.ts",
    "prepack": "node scripts/stage-assets.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@jobtrack/api": "^1.0.0",
    "fastify": "^5.12.1",
    "systray": "^1.0.5",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
