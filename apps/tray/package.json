{
  "name": "@jobtrack/tray",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runs the JobTrack API + web UI as one background process with a Windows tray icon",
  "main": "./src/cli.ts",
  "bin": {
    "jobtrack": "./bin/jobtrack.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/cli.ts",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@jobtrack/api": "*",
    "fastify": "^5.12.1",
    "systray": "^1.0.5",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
