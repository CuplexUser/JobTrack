<ui:FluentWindow
    x:Class="JobTrack.Host.UI.LogWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:JobTrack.Host.Localization"
    Title="{loc:Loc log.title}"
    Width="980"
    Height="640"
    MinWidth="560"
    MinHeight="340"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Chip"
                            MinWidth="90"
                            Padding="14,5"
                            Background="Transparent"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Title="{loc:Loc log.title}" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,4,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Two logs, one at a time: a segmented choice rather than a dropdown hiding the other. -->
            <Border
                Padding="3"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="ServerChoice"
                        Checked="OnLogChosen"
                        Content="{loc:Loc log.server}"
                        GroupName="Log"
                        IsChecked="True"
                        Style="{StaticResource SegmentStyle}" />
                    <RadioButton
                        x:Name="HostChoice"
                        Checked="OnLogChosen"
                        Content="{loc:Loc log.trayApp}"
                        GroupName="Log"
                        Style="{StaticResource SegmentStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Click="OnRefresh" Content="{loc:Loc log.refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Click="OnCopy"
                    Content="{loc:Loc log.copy}"
                    Icon="{ui:SymbolIcon Copy24}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Click="OnOpenFolder"
                    Content="{loc:Loc log.openFolder}"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="20,0,20,20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBox
                x:Name="LogText"
                Padding="14,10"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="{StaticResource MonoFont}"
                FontSize="12.5"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="False"
                Style="{x:Null}"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>

</ui:FluentWindow>
