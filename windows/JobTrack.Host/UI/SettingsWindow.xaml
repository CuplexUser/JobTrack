<ui:FluentWindow
    x:Class="JobTrack.Host.UI.SettingsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:settings="clr-namespace:JobTrack.Host.UI.Settings"
    xmlns:loc="clr-namespace:JobTrack.Host.Localization"
    Title="{loc:Loc settingsWindow.title}"
    Width="1040"
    Height="740"
    MinWidth="760"
    MinHeight="520"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Title="{loc:Loc settingsWindow.title}" Grid.Row="0" />

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            Padding="36,8,36,0"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            Transition="FadeIn">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Loc general.title}" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type settings:GeneralPage}" />
                <ui:NavigationViewItem Content="{loc:Loc database.title}" Icon="{ui:SymbolIcon Database24}" TargetPageType="{x:Type settings:DatabasePage}" />
                <ui:NavigationViewItem Content="{loc:Loc search.title}" Icon="{ui:SymbolIcon Search24}" TargetPageType="{x:Type settings:SearchPage}" />
                <ui:NavigationViewItem Content="{loc:Loc access.title}" Icon="{ui:SymbolIcon ShieldKeyhole24}" TargetPageType="{x:Type settings:AccessPage}" />
                <ui:NavigationViewItem Content="{loc:Loc updates.title}" Icon="{ui:SymbolIcon ArrowSync24}" TargetPageType="{x:Type settings:UpdatesPage}" />
                <ui:NavigationViewItem Content="{loc:Loc advanced.title}" Icon="{ui:SymbolIcon Code24}" TargetPageType="{x:Type settings:AdvancedPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Loc about.title}" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type settings:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="Snackbars" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- A band of its own under the pages, so Save reads as applying to all of them. -->
        <Border
            Grid.Row="2"
            Padding="24,14"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Info24" />
                    <!-- Honest rather than reassuring: apps/api/src/config.ts reads all of this once, at boot. -->
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:Loc settingsWindow.footerNote}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        MinWidth="96"
                        Click="OnCancel"
                        Content="{loc:Loc settingsWindow.cancel}"
                        IsCancel="True" />
                    <ui:Button
                        MinWidth="96"
                        Margin="8,0,0,0"
                        Click="OnSave"
                        Content="{loc:Loc settingsWindow.save}"
                        Icon="{ui:SymbolIcon Save24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Click="OnSaveAndRestart"
                        Content="{loc:Loc settingsWindow.saveAndRestart}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
