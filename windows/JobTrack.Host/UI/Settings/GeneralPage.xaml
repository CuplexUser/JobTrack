<Page
    x:Class="JobTrack.Host.UI.Settings.GeneralPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:JobTrack.Host.UI.Settings"
    xmlns:loc="clr-namespace:JobTrack.Host.Localization"
    Title="{loc:Loc general.title}">
    <StackPanel Margin="0,0,0,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Loc general.title}" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc general.language}" />
        <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc general.languageTitle}" Description="{loc:Loc general.languageDescription}" />
            </ui:CardControl.Header>
            <ComboBox
                x:Name="LanguageChoice"
                Width="150"
                SelectionChanged="OnLanguageSelected">
                <ComboBoxItem Tag="{x:Null}" Content="{loc:Loc general.languageSystem}" />
                <ComboBoxItem Tag="en" Content="{loc:Loc general.languageEnglish}" />
                <ComboBoxItem Tag="sv" Content="{loc:Loc general.languageSwedish}" />
            </ComboBox>
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc general.server}" />
        <ui:CardControl Icon="{ui:SymbolIcon Globe24}">
            <ui:CardControl.Header>
                <local:SettingHeader
                    Title="{loc:Loc general.addressTitle}"
                    Description="{loc:Loc general.addressDescription}" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    Width="150"
                    IsEditable="True"
                    ItemsSource="{Binding Source={x:Static local:SettingsModel.HostChoices}}"
                    Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="16,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Loc general.port}" />
                <ui:NumberBox
                    Width="130"
                    MaxDecimalPlaces="0"
                    Maximum="65535"
                    Minimum="1"
                    SpinButtonPlacementMode="Hidden"
                    Value="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ui:CardControl>
        <ui:InfoBar
            Margin="0,4,0,0"
            IsClosable="False"
            IsOpen="{Binding ExposesNetwork, Mode=OneWay}"
            Message="{loc:Loc general.networkWarning}"
            Severity="Warning"
            Title="{loc:Loc general.networkWarningTitle}" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc general.startup}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Rocket24}">
            <ui:CardControl.Header>
                <local:SettingHeader
                    Title="{loc:Loc general.autostartTitle}"
                    Description="{loc:Loc general.autostartDescription}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding Autostart}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon WindowNew24}">
            <ui:CardControl.Header>
                <local:SettingHeader
                    Title="{loc:Loc general.openBrowserTitle}"
                    Description="{loc:Loc general.openBrowserDescription}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding OpenBrowserOnStart}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc general.notifications}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Alert24}">
            <ui:CardControl.Header>
                <local:SettingHeader
                    Title="{loc:Loc general.remindersTitle}"
                    Description="{loc:Loc general.remindersDescription}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding RemindersEnabled}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24}" IsEnabled="{Binding ClaudeDesktopAvailable, Mode=OneTime}">
            <ui:CardControl.Header>
                <local:SettingHeader
                    Title="{loc:Loc general.claudeDesktopTitle}"
                    Description="{loc:Loc general.claudeDesktopDescription}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ConnectClaudeDesktop}" />
        </ui:CardControl>
    </StackPanel>
</Page>
