<Page
    x:Class="JobTrack.Host.UI.Settings.AccessPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:JobTrack.Host.UI.Settings"
    xmlns:loc="clr-namespace:JobTrack.Host.Localization"
    Title="{loc:Loc access.title}">
    <StackPanel Margin="0,0,0,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Loc access.title}" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc access.browserExtension}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Key24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc access.apiTokenTitle}" Description="{loc:Loc access.apiTokenDescription}" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:TextBox
                    Width="280"
                    ClearButtonEnabled="False"
                    FontFamily="{StaticResource MonoFont}"
                    IsReadOnly="True"
                    Text="{Binding TokenDisplay, Mode=OneWay}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Click="OnCopy"
                    Icon="{ui:SymbolIcon Copy24}"
                    ToolTip="{loc:Loc access.copyTokenTooltip}" />
                <ToggleButton
                    Margin="4,0,0,0"
                    Padding="11,8"
                    IsChecked="{Binding TokenRevealed}"
                    ToolTip="{loc:Loc access.showHideTooltip}">
                    <ui:SymbolIcon Symbol="Eye24" />
                </ToggleButton>
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon KeyReset24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc access.regenerateTitle}" Description="{loc:Loc access.regenerateDescription}" />
            </ui:CardControl.Header>
            <ui:Button Click="OnRegenerate" Content="{loc:Loc access.regenerate}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc access.webPages}" />
        <ui:CardExpander Icon="{ui:SymbolIcon ShieldGlobe24}">
            <ui:CardExpander.Header>
                <local:SettingHeader
                    Title="{loc:Loc access.corsTitle}"
                    Description="{loc:Loc access.corsDescription}" />
            </ui:CardExpander.Header>
            <ui:TextBox
                MinHeight="110"
                AcceptsReturn="True"
                FontFamily="{StaticResource MonoFont}"
                PlaceholderText="https://example.com"
                Text="{Binding CorsOrigins, UpdateSourceTrigger=PropertyChanged}"
                VerticalScrollBarVisibility="Auto" />
        </ui:CardExpander>
    </StackPanel>
</Page>
