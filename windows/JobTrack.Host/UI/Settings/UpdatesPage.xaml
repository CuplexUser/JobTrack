<Page
    x:Class="JobTrack.Host.UI.Settings.UpdatesPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:JobTrack.Host.UI.Settings"
    Title="Updates">
    <StackPanel Margin="0,0,0,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="Updates" />

        <ui:Card Margin="0,16,0,0" Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    x:Name="AppIcon"
                    Width="48"
                    Height="48"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource CardDescription}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing
                        x:Name="Busy"
                        Width="20"
                        Height="20"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="ActionButton"
                        MinWidth="160"
                        Click="OnAction" />
                </StackPanel>
                <ProgressBar
                    x:Name="DownloadProgress"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,14,0,0"
                    Maximum="1"
                    Visibility="Collapsed" />
            </Grid>
        </ui:Card>
        <ui:InfoBar
            x:Name="Problem"
            Margin="0,4,0,0"
            IsClosable="True"
            Severity="Error"
            Title="The update did not go through" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="Preferences" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <local:SettingHeader
                    Title="Check for updates automatically"
                    Description="Looks for a new release on GitHub twice a day. An update is only ever installed when you choose to. Applies immediately." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="AutoCheck" Click="OnAutoCheckChanged" />
        </ui:CardControl>
        <ui:CardAction Click="OnReleaseNotes" Icon="{ui:SymbolIcon Notebook24}">
            <local:SettingHeader Title="Release notes" Description="What changed in each version, on GitHub." />
        </ui:CardAction>
    </StackPanel>
</Page>
