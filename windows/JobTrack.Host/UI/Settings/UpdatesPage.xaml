<Page
    x:Class="JobTrack.Host.UI.Settings.UpdatesPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:JobTrack.Host.UI.Settings"
    xmlns:loc="clr-namespace:JobTrack.Host.Localization"
    Title="{loc:Loc updates.title}">
    <StackPanel Margin="0,0,0,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Loc updates.title}" />

        <ui:Card Margin="0,16,0,0" Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    x:Name="AppIcon"
                    Width="48"
                    Height="48"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource CardDescription}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing
                        x:Name="Busy"
                        Width="20"
                        Height="20"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="ActionButton"
                        MinWidth="160"
                        Click="OnAction" />
                </StackPanel>
                <ProgressBar
                    x:Name="DownloadProgress"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,14,0,0"
                    Maximum="1"
                    Visibility="Collapsed" />
            </Grid>
        </ui:Card>
        <ui:InfoBar
            x:Name="Problem"
            Margin="0,4,0,0"
            IsClosable="True"
            Severity="Error"
            Title="{loc:Loc updates.problemTitle}" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc updates.preferences}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <local:SettingHeader
                    Title="{loc:Loc updates.autoCheckTitle}"
                    Description="{loc:Loc updates.autoCheckDescription}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="AutoCheck" Click="OnAutoCheckChanged" />
        </ui:CardControl>
        <ui:CardAction Click="OnReleaseNotes" Icon="{ui:SymbolIcon Notebook24}">
            <local:SettingHeader Title="{loc:Loc updates.releaseNotesTitle}" Description="{loc:Loc updates.releaseNotesDescription}" />
        </ui:CardAction>
    </StackPanel>
</Page>
