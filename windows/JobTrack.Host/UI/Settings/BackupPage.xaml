<Page
    x:Class="JobTrack.Host.UI.Settings.BackupPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:JobTrack.Host.UI.Settings"
    xmlns:loc="clr-namespace:JobTrack.Host.Localization"
    Title="{loc:Loc backup.title}">
    <StackPanel Margin="0,0,0,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Loc backup.title}" />

        <ui:Card Margin="0,16,0,0" Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    FontSize="36"
                    Symbol="CloudArrowUp24" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource CardDescription}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing
                        x:Name="Busy"
                        Width="20"
                        Height="20"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="RunNowButton"
                        MinWidth="140"
                        Click="OnRunNow"
                        Content="{loc:Loc backup.runNow}"
                        Icon="{ui:SymbolIcon ArrowUpload24}" />
                </StackPanel>
            </Grid>
        </ui:Card>
        <ui:InfoBar
            x:Name="Problem"
            Margin="0,4,0,0"
            IsClosable="True"
            Severity="Error"
            Title="{loc:Loc backup.problemTitle}" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc backup.whereAndWhen}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc backup.enabledTitle}" Description="{loc:Loc backup.enabledDescription}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="EnabledSwitch" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc backup.folderTitle}" Description="{loc:Loc backup.folderDescription}" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:TextBox x:Name="FolderBox" Width="300" PlaceholderText="C:\Users\you\OneDrive\JobTrack" />
                <ui:Button
                    Margin="8,0,0,0"
                    Click="OnBrowse"
                    Content="{loc:Loc database.browse}"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CalendarClock24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc backup.frequencyTitle}" Description="{loc:Loc backup.frequencyDescription}" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="FrequencyBox" Width="170" SelectionChanged="OnFrequencyChanged">
                    <ComboBoxItem Tag="hourly" Content="{loc:Loc backup.hourly}" />
                    <ComboBoxItem Tag="daily" Content="{loc:Loc backup.daily}" />
                    <ComboBoxItem Tag="weekly" Content="{loc:Loc backup.weekly}" />
                </ComboBox>
                <StackPanel x:Name="HoursPanel" Margin="12,0,0,0" Orientation="Horizontal">
                    <ui:NumberBox
                        x:Name="EveryHoursBox"
                        Width="110"
                        MaxDecimalPlaces="0"
                        Maximum="24"
                        Minimum="1" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc backup.hours}" />
                </StackPanel>
                <StackPanel x:Name="TimePanel" Margin="12,0,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:Loc backup.at}" />
                    <ui:TextBox x:Name="TimeBox" Width="90" PlaceholderText="02:00" />
                </StackPanel>
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl x:Name="WeekdaysCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon CalendarLtr24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc backup.weekdaysTitle}" />
            </ui:CardControl.Header>
            <WrapPanel x:Name="WeekdaysPanel" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Checkmark24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc backup.skipUnchangedTitle}" Description="{loc:Loc backup.skipUnchangedDescription}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="SkipUnchangedSwitch" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc backup.keep}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Stack24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc backup.keepLastTitle}" Description="{loc:Loc backup.keepLastDescription}" />
            </ui:CardControl.Header>
            <ui:NumberBox
                x:Name="KeepLastBox"
                Width="130"
                MaxDecimalPlaces="0"
                Maximum="1000"
                Minimum="0" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon History24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="{loc:Loc backup.maxAgeTitle}" Description="{loc:Loc backup.maxAgeDescription}" />
            </ui:CardControl.Header>
            <ui:NumberBox
                x:Name="MaxAgeBox"
                Width="130"
                MaxDecimalPlaces="0"
                Maximum="3650"
                Minimum="0" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc backup.encryption}" />
        <ui:CardAction Click="OnOpenEncryption" Icon="{ui:SymbolIcon LockClosed24}">
            <local:SettingHeader x:Name="EncryptionHeader" Title="{loc:Loc backup.encryptionTitle}" />
        </ui:CardAction>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
            <ui:Button
                x:Name="SaveButton"
                MinWidth="120"
                Appearance="Primary"
                Click="OnSave"
                Content="{loc:Loc backup.save}"
                Icon="{ui:SymbolIcon Save24}" />
            <ui:Button
                x:Name="TestButton"
                MinWidth="120"
                Margin="8,0,0,0"
                Click="OnTest"
                Content="{loc:Loc backup.test}"
                Icon="{ui:SymbolIcon CheckmarkCircle24}" />
        </StackPanel>
        <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource CardDescription}"
            Text="{loc:Loc backup.appliesNow}"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
