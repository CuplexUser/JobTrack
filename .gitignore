node_modules/
dist/
coverage/
*.tsbuildinfo
*.tgz

# Staged for `npm publish`/`npm pack` by apps/tray/scripts/stage-assets.mjs — regenerated,
# never hand-edited.
apps/tray/vendor/

# Written by scripts/check-publishable.mjs --plan, read by the publish workflow.
publish-plan.json

# Database — local data, never committed. Not scoped to data/: a misconfigured DB_FILE
# has put one somewhere else before, and a stray 6 MB database must not be committable.
*.db
*.db-shm
*.db-wal
data/active-db.json
data/api-token

# Transformers.js model cache
.cache/
.models/

# Windows installer build output. The payload is assembled from published npm tarballs (or from
# `npm pack` with --local) by windows/scripts/build-payload.mjs, and version.props is generated
# alongside it -- all regenerated on every build, never hand-edited.
windows/installer/payload/
windows/installer/Output/
windows/version.props
bin/
obj/

.env
.env.local
.DS_Store
Thumbs.db
.vscode/
.idea/
